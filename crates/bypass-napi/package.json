{
  "name": "@hipago/bypass-napi",
  "version": "0.1.0",
  "description": "ISP bypass native addon for Node.js (DoH + TLS fragmentation + Chrome fingerprint)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "bypass-napi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform"
  }
}
