{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "HiPaGo",
  "version": "9.9.9",
  "identifier": "com.hipago.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/build-static.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "HiPaGo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com https://hitomi.la https://*.hitomi.la https://*.gold-usergeneratedcontent.net",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://hitomi.la https://*.hitomi.la https://*.gold-usergeneratedcontent.net",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:*",
        "connect-src": "ipc: http://ipc.localhost http://localhost:* ws://localhost:* https://api.github.com https://hitomi.la https://*.hitomi.la https://*.gold-usergeneratedcontent.net",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:* https://hitomi.la https://*.hitomi.la https://*.gold-usergeneratedcontent.net",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-eval' http://localhost:*"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/image-cache",
          "$APPCACHE/image-cache/**",
          "$APPDATA/downloads",
          "$APPDATA/downloads/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "VTSB",
    "homepage": "https://github.com/VTSB/HiPaGo",
    "copyright": "Copyright © 2026 VTSB",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Cross-platform gallery browser and offline library manager.",
    "longDescription": "HiPaGo is a cross-platform gallery browser with offline search, downloads, and library management.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows.ps1",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/VTSB/HiPaGo/releases/latest/download/latest.json"],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQUE3NUFBOEY4RDEzNzcKUldSM0U0MlBxbldxTEFaUDRENjJRWGhaOHkrVENncHdVWG1CZ1pqTWE3a28wMC9Za0hrR2VwWVAK"
    }
  }
}
