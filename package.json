{
  "name": "hipago",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "build:static": "node scripts/build-static.mjs",
    "build:napi": "node scripts/build-napi.mjs",
    "build:tauri": "tauri build",
    "build:bypass:android": "node scripts/build-android.mjs",
    "build:bypass:ios": "node scripts/build-ios.mjs",
    "build:android": "node scripts/build-android.mjs && node scripts/build-static.mjs && cap sync android && cd android && ./gradlew assembleDebug",
    "build:ios": "node scripts/build-ios.mjs && node scripts/build-static.mjs && cap sync ios",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6",
    "@capacitor/core": "^6",
    "@esbuild/linux-x64": "^0.27.3",
    "@rollup/rollup-linux-x64-gnu": "^4.57.1",
    "@tanstack/react-query": "^5.90.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "fflate": "^0.8.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.11",
    "@hipago/bypass-napi": "file:crates/bypass-napi"
  },
  "devDependencies": {
    "@capacitor/android": "^6",
    "@capacitor/cli": "^6",
    "@capacitor/ios": "^6",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "lightningcss": "^1.30.2",
    "vitest": "^4.0.18"
  }
}
