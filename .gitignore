# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
/.pnpm-store/
/.claude/scheduled_tasks.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# auto-copied binaries
/public/*.wasm

# misc
.DS_Store
*.pem

# release signing material (public certificates may be committed separately)
*.pfx
*.p12
*.key
*.jks
*.keystore
/release-secrets/

# IDE local state
/.idea/caches/
/android/.idea/caches/
/android/.idea/deviceManager.xml
/android/.idea/runConfigurations.xml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri
/src-tauri/target/
/scripts/updater-signature-verifier/target/

# rust workspace + crate build artifacts
/target/
/crates/*/target/
/crates/*/node_modules/
/crates/*/*.node

# capacitor native build artifacts
/android/app/build/
/ios/App/build/
/ios/App/Pods/

# bypass-uniffi generated outputs (.so + Kotlin bindings) — produced by
# scripts/build-android.mjs, rebuilt in CI before assembleRelease.
/android/app/generated/

# build script temp
/.build-backup/
/.api-backup/

# translate-tags CLI output (intermediate artifacts)
/scripts/output/

.omc
.omx
.sisyphus
