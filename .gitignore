# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
/.pnpm-store/
/.claude/scheduled_tasks.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# auto-copied binaries
/public/*.wasm

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri
/src-tauri/target/

# rust workspace + crate build artifacts
/target/
/crates/*/target/
/crates/*/node_modules/
/crates/*/*.node

# capacitor native build artifacts
/android/app/build/
/ios/App/build/
/ios/App/Pods/

# bypass-uniffi cross-compiled libs (generated by scripts/build-android.mjs,
# rebuilt in CI before assembleRelease — never commit the .so)
/android/app/src/main/jniLibs/*/*.so

# build script temp
/.build-backup/
/.api-backup/

# translate-tags CLI output (intermediate artifacts)
/scripts/output/

.omc
.omx
.sisyphus
