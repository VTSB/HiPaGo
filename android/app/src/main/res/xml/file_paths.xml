<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- UpdaterPlugin writes APK downloads here
         (Context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)).
         Exposed via FileProvider so the install intent can read it on
         Android 7+ without N+ URI exposure errors. -->
    <external-files-path name="updater_downloads" path="Download/" />
</paths>
